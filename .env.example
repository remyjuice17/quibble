# --- Multiplayer (Supabase Realtime) ---
# Create a free project at https://supabase.com, then copy the Project URL and
# the `anon` public key from Project Settings → API.
# Both are PUBLIC (safe to expose in the browser). Without them the app still
# runs in solo mode. No database tables or schema are required — the game uses
# Realtime Presence + Broadcast only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Word validation is fully client-side against the bundled ENABLE word list
# (public/enable1.txt) — there is no dictionary API key to configure.
